# syntax=docker/dockerfile:1
# ---------- Build stage ----------
FROM node:20-bookworm-slim AS buildrc

WORKDIR /app/client

COPY client/package.json client/package-lock.json* ./
RUN --mount=type=cache,target=/root/.npm \
    npm ci --no-audit --no-fund

COPY client/tsconfig.json client/tsconfig.node.json ./
COPY client/vite.config.ts ./
COPY client/index.html ./
COPY client/public ./public
COPY client/src ./src

# Optional build-time override for the API origin baked into the SPA bundle.
# Leave unset for same-origin (the nginx config proxies /api, /uploads and
# /renders to the server service) — that's the supported setup.
ARG VITE_API_BASE=
ENV VITE_API_BASE=$VITE_API_BASE

RUN npm run build

# ---------- Runtime stage: nginx static serve ----------
FROM nginx:1.27-alpine

# SPA fallback: every unknown path serves index.html so client-side routing
# works. Proxied `/api/*` requests go to the server service.
COPY docker/nginx.client.conf /etc/nginx/conf.d/default.conf
COPY --from=buildrc /app/client/dist /usr/share/nginx/html

EXPOSE 5173

CMD ["nginx", "-g", "daemon off;"]
