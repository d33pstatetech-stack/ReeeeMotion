{
  "name": "remotion-editor-client",
  "private": true,
  "version": "0.1.0",
  "description": "React + Vite + TypeScript UI for the Remotion video editor. Owns the timeline JSON state, uses @remotion/player for live preview, supports audio/text overlays and shareable URLs.",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@radix-ui/react-slider": "1.2.1",
    "@radix-ui/react-tooltip": "1.1.4",
    "@remotion/player": "4.0.290",
    "@remotion/transitions": "4.0.290",
    "lucide-react": "0.469.0",
    "lz-string": "1.5.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "remotion": "4.0.290",
    "zustand": "4.5.5"
  },
  "devDependencies": {
    "@types/lz-string": "1.5.0",
    "@types/node": "20.11.30",
    "@types/react": "18.3.12",
    "@types/react-dom": "18.3.1",
    "@vitejs/plugin-react": "4.3.4",
    "autoprefixer": "10.4.20",
    "jsdom": "24.1.3",
    "postcss": "8.4.49",
    "tailwindcss": "3.4.17",
    "typescript": "5.4.5",
    "vite": "5.4.11",
    "vitest": "1.6.1"
  }
}
