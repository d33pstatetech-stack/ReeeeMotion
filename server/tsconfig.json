{
  "compilerOptions": {
    "target": "ES2020",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "outDir": "dist",
    
    "baseUrl": "..",
    "paths": {
      "compositions/types": ["./compositions/src/types.ts"],
      "compositions/*": ["./compositions/src/*"]
    },
    "strict": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "isolatedModules": false,
    "allowSyntheticDefaultImports": true
  },
  "include": ["src"]
}
