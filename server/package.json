{
  "name": "remotion-editor-server",
  "private": true,
  "version": "0.1.0",
  "description": "Express backend: handles media uploads via multer, bundles the Remotion project, renders MP4 via @remotion/renderer.",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/server/src/index.js",
    "typecheck": "tsc --noEmit",
    "ensure-browser": "node scripts/ensure-browser.mjs",
    "postinstall": "node scripts/ensure-browser.mjs || exit 0"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.489",
    "@remotion/renderer": "4.0.489",
    "cors": "2.8.5",
    "dotenv": "16.4.5",
    "express": "4.21.2",
    "multer": "^2.0.2",
    "nanoid": "3.3.7"
  },
  "devDependencies": {
    "@types/cors": "2.8.17",
    "@types/express": "4.17.21",
    "@types/multer": "1.4.12",
    "@types/node": "20.11.30",
    "tsx": "4.19.2",
    "typescript": "5.4.5"
  }
}
